---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	intake(intake)
	classifier(classifier)
	rebooking_agent(rebooking_agent)
	refund_agent(refund_agent)
	compensation_agent(compensation_agent)
	tools(tools)
	policy_checker(policy_checker)
	supervisor(supervisor)
	escalation_agent(escalation_agent)
	final_response_agent(final_response_agent)
	__end__([<p>__end__</p>]):::last
	__start__ --> intake;
	classifier -.-> compensation_agent;
	classifier -.-> escalation_agent;
	classifier -.-> rebooking_agent;
	classifier -.-> refund_agent;
	compensation_agent --> policy_checker;
	escalation_agent --> final_response_agent;
	intake --> classifier;
	policy_checker -.-> compensation_agent;
	policy_checker -.-> escalation_agent;
	policy_checker -.-> final_response_agent;
	policy_checker -.-> rebooking_agent;
	policy_checker -.-> refund_agent;
	policy_checker -.-> supervisor;
	rebooking_agent -. &nbsp;__end__&nbsp; .-> policy_checker;
	rebooking_agent -.-> tools;
	refund_agent --> policy_checker;
	supervisor -.-> escalation_agent;
	supervisor -.-> final_response_agent;
	tools --> rebooking_agent;
	final_response_agent --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
